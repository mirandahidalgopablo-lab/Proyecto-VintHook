# ─────────────────────────────────────────────
# VintHook · configuration template
# Copy to .env and fill in your own values. Never commit .env.
# ─────────────────────────────────────────────

# Core
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:10000
PORT=10000
GUNICORN_THREADS=8
DATA_ENCRYPTION_KEY=another-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://vinthook:vinthook@localhost:5432/vinthook
DB_POOL=5
DB_POOL_MAX=20

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (subscriptions + webhooks)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_PRICE_ID_YEARLY=price_xxx
STRIPE_PRICE_ID_MAX=price_xxx
STRIPE_PRICE_ID_MAX_YEARLY=price_xxx

# Google Gemini (AI features)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Transactional email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VintHook <no-reply@example.com>

# Vinted scanner tuning
VINTED_TIMEOUT=10
VINTED_MAX_RETRIES=3
VINTED_RPS=5
VINTED_BURST=10
VINTED_PROXY_URLS=
CATALOG_CACHE_TTL=300

# AutoPilot
AUTOPILOT_ENABLED=true
AUTOPILOT_WORKERS=4

# Browser extension
VINTHOOK_EXTENSION_INSTALL_URL=https://chromewebstore.google.com/

# Telegram / Discord: each user connects their own bot token / webhook URL
# from the dashboard, so no global keys are needed here.
